{
  "name": "nmo-helper",
  "version": "5.4.0",
  "description": "Расширение для браузера, которое поможет вам решить тесты (ИОМ'ы) на портале НМО — https://a.edu.rosminzdrav.ru\r </br>\r Прост в установке, работает из коробки.\r </br>\r Ответы берутся из баз поиска ответов, а также с помощью AI.\r </br>",
  "main": "ai.js",
  "scripts": {
    "build": "node build.js",
    "package:linux": "node scripts/package-linux.cjs",
    "package:yandex": "node scripts/package-yandex.cjs",
    "package:all": "node scripts/package-all.cjs",
    "package:ready": "node scripts/package-ready.cjs",
    "package:release": "node scripts/package-all.cjs && node scripts/package-linux.cjs --skip-build && node scripts/package-ready.cjs",
    "package:github": "node scripts/package-all.cjs && node scripts/package-linux.cjs --skip-build && node scripts/write-release-checksums.cjs",
    "validate:release": "node scripts/validate-release.cjs",
    "dev": "node build.js --watch",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Samyray24/nmo-helper.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Samyray24/nmo-helper/issues"
  },
  "homepage": "https://github.com/Samyray24/nmo-helper#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.1.40",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.0",
    "esbuild-sass-plugin": "^3.7.0",
    "eslint": "^10.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fflate": "0.8.3",
    "jsdom": "^29.0.2",
    "sass": "^1.99.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "med-pdf-nmo": "^0.2.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
